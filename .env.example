# ============================================================
#  本地调试用的环境变量示例
#  复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#  线上运行时这些值配置在 GitHub 仓库 Secrets 里，不需要 .env
# ============================================================

# QQ 邮箱 SMTP 授权码
# 获取方式：QQ邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
# 注意：是"授权码"，不是 QQ 登录密码
MAIL_AUTH_CODE=your_qq_smtp_auth_code

# Google Gemini API Key（主 LLM，免费档 1500 次/天）
# 获取：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# DeepSeek API Key（兜底 LLM）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key

# 发件邮箱账号（默认从 config.yaml 读取，此处可覆盖）
# MAIL_FROM=986882896@qq.com
